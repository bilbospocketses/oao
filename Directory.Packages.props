<Project>

  <!--
    Central Package Management (CPM). Every NuGet version for the solution is
    declared ONCE here; project files carry versionless <PackageReference>s. This
    makes it impossible for oao.Web and oao.Tests to pin the same package at
    different versions (the drift that produced the NU1605 package-downgrade
    build break). Dependabot updates the single <PackageVersion> below and every
    project moves together.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Let a <PackageVersion> below pin a TRANSITIVE dependency (used for the
         security overrides at the end of the ItemGroup). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.7.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- Security overrides: transitively pinned to force a patched version of a
         package we don't reference directly. Revisit / remove when the parent
         package ships a fix and Dependabot can bump it normally.
         - AngleSharp (via bunit): GHSA-pgww-w46g-26qg (mXSS), patched in 1.5.0.
         - SQLitePCLRaw.lib.e_sqlite3 (via EF Core Sqlite): CVE-2025-6965 /
           GHSA-2m69-gcr7-jv3q, fixed by SQLite 3.50.2+; 2.1.11 is the last
           vulnerable build, 2.1.12 is out of the affected range. -->
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
